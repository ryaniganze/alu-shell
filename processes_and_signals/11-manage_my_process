#!/usr/bin/env bash
# Start, stop, or restart the manage_my_process background process.
PIDFILE="/var/run/my_process.pid"
PROCESS="./manage_my_process"

start_process() {
    "$PROCESS" &
    echo "$!" > "$PIDFILE"
}

stop_process() {
    if [ -f "$PIDFILE" ]; then
        process_id=$(cat "$PIDFILE")

        if kill -0 "$process_id" 2>/dev/null; then
            kill "$process_id"
        fi

        rm -f "$PIDFILE"
    fi
}

case "$1" in
    start)
        start_process
        echo "manage_my_process started"
        ;;
    stop)
        stop_process
        echo "manage_my_process stopped"
        ;;
    restart)
        stop_process
        start_process
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        exit 1
        ;;
esac
